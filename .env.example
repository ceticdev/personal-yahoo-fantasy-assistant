# Copy to .env and fill in. Never commit the real .env file.
#
# Yahoo app credentials (from https://developer.yahoo.com/apps/).
# Request the READ-ONLY fantasy sports scope (fspt-r) only. This build has
# no write tools, so there is no reason to request fspt-w.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=oob

# Where the OAuth token vault file lives. Defaults to
# ~/.config/yahoo-fantasy-mcp/token.json if unset. Keep this OUTSIDE the repo
# and outside any directory that gets committed or synced to a client config.
YAHOO_FANTASY_MCP_TOKEN_PATH=

# League identity (read-only defaults used by tool descriptions/logging;
# every call still takes explicit league_key/team_key arguments).
YAHOO_FANTASY_DEFAULT_LEAGUE_KEY=
YAHOO_FANTASY_DEFAULT_TEAM_KEY=

# Cache TTL in seconds for Yahoo reads. Short by default so lineup decisions
# are never made against silently stale state.
YAHOO_FANTASY_MCP_CACHE_TTL_SECONDS=120

# Log level for structured JSON logs (DEBUG/INFO/WARNING/ERROR).
YAHOO_FANTASY_MCP_LOG_LEVEL=INFO
